# Production BACKEND inputs for Convex production / outgoing-warbler-782 only.
# Copy to .env.convex-production.local and fill locally; that file is Git-ignored.
# Inventory: docs/features/Production_Environment_Inventory.md
# This file is not for Vercel frontend projects and is not a CLI deploy-key file.
# Blank values are placeholders, not instructions to clear existing settings.

# PRESERVE the existing production auth secret and pinned signing-key documents.
# Coordinate a separate auth/key rotation before replacing these values.
BETTER_AUTH_SECRET=
JWKS=

# Exact comma-separated HTTPS browser origins for Admin, Teacher, Portal,
# Platform, Apply, and any other reviewed auth/admissions callback origins.
# Example format: https://admin.example.com,https://teacher.example.com
TRUSTED_ORIGINS=

# Canonical production Apply origin, without a path.
APPLICATION_ORIGIN=
# Optional alias when APPLICATION_ORIGIN is absent; normally leave unconfigured.
# APPLY_APP_ORIGIN=

# Required for backend signup verification and admission-conversion emails.
# Can share values with WWW if the Resend key permits the verified sender.
RESEND_API_KEY=
MELO_EMAIL_FROM=

# Required for enabled AI generation and OCR; this key lives on Convex only.
OPENROUTER_API_KEY=

# PRESERVE the existing encryption key if payment credentials are already stored.
# Replacing it requires decrypting/re-encrypting the stored payment credentials.
BILLING_PROVIDER_SECRET_ENCRYPTION_KEY=

# Optional provider attribution; code has defaults.
# OPENROUTER_HTTP_REFERER=https://www.meloschool.com/
# OPENROUTER_APP_TITLE=Melo School OS

# Optional AI settings; keep code defaults unless deliberately overriding.
# SCHOOL_AI_CURRICULUM_RUNTIME=openrouter
# SCHOOL_AI_CURRICULUM_MODEL=openai/gpt-5-mini
# SCHOOL_AI_LESSON_PLAN_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# SCHOOL_AI_STUDENT_NOTE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# SCHOOL_AI_ASSIGNMENT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# SCHOOL_AI_QUESTION_BANK_MODEL=openai/gpt-oss-120b:free
# SCHOOL_AI_CBT_MODEL=openai/gpt-oss-120b:free
# OPENROUTER_OCR_MODEL=openai/gpt-5.6-luna
# OPENROUTER_OCR_IMAGE_MODEL=openai/gpt-5.6-luna
# OPENROUTER_PDF_ENGINE=mistral-ocr

# Optional legacy identity controls: preserve reviewed production policy.
# LEGACY_SUBJECT_FALLBACK_ENABLED=
# LEGACY_SUBJECT_TRUSTED_ISSUER=

# Temporary authorized bootstrap only; ordinary logins do not require it.
# PLATFORM_BOOTSTRAP_TOKEN=

# Convex automatically supplies CONVEX_SITE_URL and CONVEX_CLOUD_URL.
# SITE_URL is an unused fallback when the built-in site URL exists.
# Let the deployment supply NODE_ENV.
# Paystack keys are per-school settings stored in Convex, not global env inputs.
# Demo reset, judge fixture, and tenant purge operator settings are intentionally
# excluded. Configure destructive tooling only under a separate reviewed procedure.
