# J-Star Code Reviewer
# Required: Gemini API key (or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
# Required: Groq API key for LLM reviews
GROQ_API_KEY=your_groq_api_key_here
# Optional: Override the embedding model
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional: Override the default model
# REVIEW_MODEL_NAME=moonshotai/kimi-k2-instruct-0905

# Non-destructive, loopback-only admissions Playwright smoke.
# Run with: E2E_ADMISSIONS_SCHOOL_SLUG=<published-school> pnpm test:e2e:admissions-smoke
E2E_ADMISSIONS_SCHOOL_SLUG=
E2E_ADMIN_ORIGIN=http://localhost:3002
E2E_APPLY_ORIGIN=http://localhost:3004
# This smoke never signs in, resets fixtures, creates payments, or mutates admissions data.
