{
  "name": "school-management-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build --concurrency=1",
    "dev": "turbo dev",
    "start": "pnpm --parallel --filter @school/www --filter @school/teacher --filter @school/admin --filter @school/portal --filter @school/platform --filter @school/sites start",
    "start:www": "pnpm --filter @school/www start",
    "start:teacher": "pnpm --filter @school/teacher start",
    "start:admin": "pnpm --filter @school/admin start",
    "start:portal": "pnpm --filter @school/portal start",
    "start:platform": "pnpm --filter @school/platform start",
    "start:sites": "pnpm --filter @school/sites start",
    "prod": "pnpm build && pnpm start",
    "prod:www": "pnpm --filter @school/www build && pnpm start:www",
    "prod:teacher": "pnpm --filter @school/teacher build && pnpm start:teacher",
    "prod:admin": "pnpm --filter @school/admin build && pnpm start:admin",
    "prod:portal": "pnpm --filter @school/portal build && pnpm start:portal",
    "prod:platform": "pnpm --filter @school/platform build && pnpm start:platform",
    "prod:sites": "pnpm --filter @school/sites build && pnpm start:sites",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck --concurrency=1",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:build-gate": "turbo test:e2e",
    "test:e2e:install": "playwright install chromium",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen",
    "setup:convex": "powershell -ExecutionPolicy Bypass -File scripts/setup-convex.ps1",
    "setup:convex:unix": "bash scripts/setup-convex.sh",
    "check:toasts": "node scripts/check-toast-usage.mjs"
  },
  "dependencies": {
    "@playwright/test": "^1.59.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "convex": "^1.34.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.4",
    "globals": "^17.5.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@10.33.2"
}
