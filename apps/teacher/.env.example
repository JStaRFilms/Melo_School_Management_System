# Convex Configuration
# Get your Convex URL by running: npx convex dev
# This will create a new Convex project and provide you with the URL
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-project.convex.site

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-here
SITE_URL=http://localhost:3001

# Trusted Origins (comma-separated)
TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# OpenRouter AI Configuration
# These variables are read by the Convex action runtime, NOT by the Next.js app.
# Run from the repo root after `npx convex dev` has linked the deployment:
#
#   npx convex env set OPENROUTER_API_KEY "your-openrouter-api-key"
#   npx convex env set OPENROUTER_HTTP_REFERER "http://localhost:3001"
#   npx convex env set OPENROUTER_APP_TITLE "School Management System Teacher"
#
# Lesson-plan, student-note, assignment, question-bank, and CBT draft generation
# all run inside `packages/convex/functions/academic/documentGeneration.ts`.
# Do NOT set OPENROUTER_API_KEY here — keeping it out of the app .env keeps the
# key off the serverless bundle and the browser.

# Optional: Per-output model overrides (also set on Convex, not here)
# Defaults already live in packages/ai/src/models.ts.
# Uncomment these only if you want to override them without changing code.
# SCHOOL_AI_LESSON_PLAN_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# SCHOOL_AI_STUDENT_NOTE_MODEL=inclusionai/ling-2.6-flash:free
# SCHOOL_AI_ASSIGNMENT_MODEL=inclusionai/ling-2.6-flash:free
# SCHOOL_AI_QUESTION_BANK_MODEL=openai/gpt-oss-120b:free
# SCHOOL_AI_CBT_MODEL=openai/gpt-oss-120b:free

# Optional: For production
# NODE_ENV=production
