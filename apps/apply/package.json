{
  "name": "@school/apply",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3004 -H 0.0.0.0",
    "build": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build --webpack",
    "start": "next start --port 3004",
    "lint": "pnpm -C ../.. exec eslint apps/apply",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.11.4",
    "@school/auth": "workspace:*",
    "@school/convex": "workspace:*",
    "@school/shared": "workspace:*",
    "better-auth": "^1.2.0",
    "convex": "^1.0.0",
    "next": "^16.2.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
