# Production inputs for the existing Vercel projects.
# Copy to .env.vercel-production.local and fill locally; that file is Git-ignored.
# These inputs must be routed by app, not uploaded wholesale to every project.
# Inventory: docs/features/Production_Environment_Inventory.md
# Use Production assignments only. Keep local Development and Preview unchanged.
# Blank values are placeholders, not instructions to clear existing settings.

# ADMIN, TEACHER, PORTAL, PLATFORM, APPLY: same production Convex URLs.
# Copy the exact cloud/site URLs for production / outgoing-warbler-782.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ADMIN only: optional production Apply origin override.
# Without this override, Admin uses the canonical link returned by Convex.
# NEXT_PUBLIC_APPLY_ORIGIN=https://your-production-apply-domain

# PLATFORM only: actual production Platform origin, not localhost.
NEXT_PUBLIC_PLATFORM_SITE_URL=

# WWW only: public canonical origin and server-side contact email.
NEXT_PUBLIC_SITE_URL=
RESEND_API_KEY=
MELO_EMAIL_FROM=
MELO_CONTACT_TO=
# WWW sender defaults to Melo <hey@jstarstudios.com> when omitted.
# WWW contact recipient defaults to melo@jstarstudios.com when omitted.
# Confirm the sender is verified for the Resend key before using the defaults.

# OPTIONAL aliases, normally omit them when the public Convex URLs above are set.
# CONVEX_SITE_URL=  # Admin and Apply server document routes; same production site URL.
# CONVEX_URL=       # Admin, Teacher, Portal route fallback; same production cloud URL.

# SITES has no runtime environment inputs in the current code.
# Auth secrets, trusted origins, OpenRouter keys, and payment encryption go to Convex.
# CONVEX_DEPLOY_KEY is a separate CI/deployment credential, only for a job that
# actually deploys the backend. It is not a frontend runtime requirement.
